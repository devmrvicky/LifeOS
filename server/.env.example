# Copy this file to server/.env and fill in real values. Never commit .env.

# Which AI backend to use: "openrouter" (default, free tier) or "anthropic" (paid, optional).
AI_PROVIDER=openrouter

# --- OpenRouter (default provider) ---
# Get a free key at https://openrouter.ai/keys — no credit card required.
OPENROUTER_API_KEY=sk-or-your-key-here
# Model is configuration, not a code constant — free models rotate. Default
# "openrouter/free" lets OpenRouter pick an available free model for you,
# automatically preferring one that supports image input when a request
# needs it. Pin a specific model (e.g. google/gemma-4-31b-it:free) instead
# if you want stability over automatic rotation.
OPENROUTER_MODEL=openrouter/free
# Set to "true" only if you pin a text-only model above — forces images
# through server-side OCR first instead of sending them to the model directly.
OPENROUTER_TEXT_ONLY=false
# Optional — sent as attribution headers OpenRouter recommends.
OPENROUTER_SITE_URL=http://localhost:5173

# --- Anthropic (optional, paid — only used when AI_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Server ---
PORT=8787
# Comma-separated list of allowed frontend origins for CORS. Defaults to the
# Vite dev server origin if unset.
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
