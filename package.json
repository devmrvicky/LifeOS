{
  "name": "lifeos",
  "private": true,
  "version": "1.2.0",
  "workspaces": ["frontend", "server", "shared"],
  "scripts": {
    "dev": "concurrently -n server,frontend -c blue,green \"npm run dev:server\" \"npm run dev:frontend\"",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:server": "npm run dev --workspace=server",
    "build": "npm run build --workspace=frontend",
    "test": "npm run test --workspace=frontend && npm run test --workspace=server",
    "test:frontend": "npm run test --workspace=frontend",
    "test:server": "npm run test --workspace=server",
    "typecheck:server": "npm run typecheck --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
